    "bilibili-web-fetch_user_post_videos_v2": {
      "method": "GET",
      "path": "/api/v1/bilibili/web/fetch_user_post_videos_v2",
      "operationId": "fetch_user_post_videos_v2_api_v1_bilibili_web_fetch_user_post_videos_v2_get",
      "summary": "获取用户主页作品数据V2/Get user homepage video data V2",
      "querySchema": {
        "type": "object",
        "properties": {
          "uid": {
            "type": "string",
            "description": "用户UID",
            "title": "Uid",
            "example": "178360345"
          },
          "pn": {
            "type": "integer",
            "minimum": 1,
            "description": "页码，无上限/Page number, no cap",
            "default": 1,
            "title": "Pn"
          },
          "ps": {
            "type": "integer",
            "maximum": 100,
            "minimum": 1,
            "description": "每页数量，最大100/Page size, max 100",
            "default": 30,
            "title": "Ps"
          },
          "keyword": {
            "type": "string",
            "description": "关键词，留空返回全部/Keyword, empty returns all",
            "default": "",
            "title": "Keyword"
          }
        },
        "required": [
          "uid"
        ],
        "additionalProperties": false
      },
      "bodySchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
